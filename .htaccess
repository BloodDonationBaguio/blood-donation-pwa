Options -MultiViews -Indexes

# Charset
AddDefaultCharset UTF-8

# Ensure correct MIME types
AddType application/javascript .js
AddType application/json .json

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /blood-donation-pwa/

# Allow direct access to service worker and manifest
RewriteRule ^(sw\.js|manifest\.json)$ - [L]

# Allow common static assets without rewriting
RewriteRule ^(css/.*|assets/.*|js/.*|images/.*|fonts/.*)$ - [L]

# Front controller: send non-existing paths to index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]
</IfModule>

# Fallback: make sure PHP files are handled by PHP
<FilesMatch "\.php$">
    SetHandler application/x-httpd-php
</FilesMatch>
