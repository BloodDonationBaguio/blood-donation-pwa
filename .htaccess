Options -MultiViews -Indexes

# Charset
AddDefaultCharset UTF-8

# Ensure correct MIME types
AddType application/javascript .js
AddType application/json .json

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Allow direct access to service worker and manifest (root)
RewriteRule ^(sw\.js|manifest\.json)$ - [L]

# Allow direct access to service worker and manifest (subfolder)
RewriteRule ^blood-donation-pwa/(sw\.js|manifest\.json)$ - [L]

# Allow common static assets without rewriting (root and subfolder)
RewriteRule ^(css/.*|assets/.*|js/.*|images/.*|fonts/.*)$ - [L]
RewriteRule ^blood-donation-pwa/(css/.*|assets/.*|js/.*|images/.*|fonts/.*)$ - [L]

# Allow direct access to test files and diagnostic tools
RewriteRule ^(test_.*\.php|.*_diagnostic\.php|.*_test\.php|health\.php|optimize_.*\.php|monitoring_.*\.php|connection_.*\.php)$ - [L]

# Front controller: send non-existing paths to index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]
</IfModule>

# Fallback: make sure PHP files are handled by PHP
<FilesMatch "\.php$">
    SetHandler application/x-httpd-php
</FilesMatch>
