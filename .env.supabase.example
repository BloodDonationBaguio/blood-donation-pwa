# Supabase Configuration for Blood Donation PWA
# Copy this to your .env file and update with your actual Supabase credentials

# Supabase Project URL (get from Supabase Dashboard > Settings > API)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Key (for client-side operations)
SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (for server-side operations - keep this secret!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: Database connection string (alternative format)
# DATABASE_URL=postgresql://postgres:password@your-project-id.supabase.co:5432/postgres

# Application Settings
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-domain.com

# Email Settings (if using Supabase Auth)
# SUPABASE_AUTH_ENABLED=true

# Security Settings
SESSION_SECURE=true
SESSION_HTTPONLY=true
SESSION_SAMESITE=Lax